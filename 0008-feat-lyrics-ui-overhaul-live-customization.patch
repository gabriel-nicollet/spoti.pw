+static CGFloat styleNumber(NSString *key, CGFloat fallback) {
+    NSNumber *stored = [NSUserDefaults.standardUserDefaults objectForKey:key];
+    return stored ? stored.doubleValue : fallback;
+}
+
 CGFloat SGRLyricsStyleFontSize(void) {
-    double value = [NSUserDefaults.standardUserDefaults doubleForKey:SGRKeyLyricsStyleFontSize];
-    return value > 0.0 ? (CGFloat)value : SGRLyricsStyleDefaultFontSize();
+    return styleNumber(SGRKeyLyricsStyleFontSize, SGRLyricsStyleDefaultFontSize());
 }

 CGFloat SGRLyricsStyleFontWeight(void) {
-    double value = [NSUserDefaults.standardUserDefaults doubleForKey:SGRKeyLyricsStyleFontWeight];
-    return value > 0.0 ? (CGFloat)value : SGRLyricsStyleDefaultFontWeight();
+    return styleNumber(SGRKeyLyricsStyleFontWeight, SGRLyricsStyleDefaultFontWeight());
+}
+
+CGFloat SGRLyricsStyleLineGap(void) {
+    return styleNumber(SGRKeyLyricsStyleLineGap, 24.0);
+}
+
+CGFloat SGRLyricsStyleDim(void) {
+    return styleNumber(SGRKeyLyricsStyleDim, 0.30);
+}
+
+CGFloat SGRLyricsStyleBlur(void) {
+    return styleNumber(SGRKeyLyricsStyleBlur, 6.0);
+}
+
+CGFloat SGRLyricsStyleBloom(void) {
+    return styleNumber(SGRKeyLyricsStyleBloom, 0.0);
 }
@@ -132,6 +159,70 @@ SGModRow *SGRLyricsStyleTuneRow(void) {
     return row;
 }

+static void setStyleValue(NSString *key, double value) {
+    [NSUserDefaults.standardUserDefaults setDouble:value forKey:key];
+    [NSNotificationCenter.defaultCenter postNotificationName:SGRLyricsTextDidChangeNotification object:nil];
+}
+
+static SGModRow *styleSlider(NSString *title, NSString *info, double min, double max, double step,
+                             NSString *key, double fallback, NSString *(^format)(double)) {
+    return SGSliderRow(title, info, min, max, step,
+                       ^double { return styleNumber(key, fallback); },
+                       ^(double value) { setStyleValue(key, value); },
+                       format);
+}
+
+SGModRow *SGRLyricsStyleCustomizeRow(void) {
+    return SGPageRow(@"Customize lyrics", ^{
+        SGModPage *page = [[SGModPage alloc] initWithTitle:@"Customize lyrics"
+                                                      intro:@"Everything here updates the lyrics page immediately. The preview uses the same values."
+                                                   sections:@[
+            SGSection(nil, @[
+                SGRLyricsStylePreviewRow()
+            ]),
+            SGSection(@"Text", @[
+                styleSlider(@"Size", @"Size of the active lyric", 20.0, 44.0, 1.0,
+                            SGRKeyLyricsStyleFontSize, 30.0,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.0f pt", value]; }),
+                styleSlider(@"Weight", @"Font thickness", UIFontWeightUltraLight, UIFontWeightBlack, 0.05,
+                            SGRKeyLyricsStyleFontWeight, UIFontWeightBold,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.2f", value]; }),
+                styleSlider(@"Line spacing", @"Distance between lyric lines", 8.0, 44.0, 1.0,
+                            SGRKeyLyricsStyleLineGap, 24.0,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.0f pt", value]; }),
+                styleSlider(@"Inactive opacity", @"Brightness of lyrics that are not being sung", 0.10, 0.70, 0.05,
+                            SGRKeyLyricsStyleDim, 0.30,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.0f%%", value * 100.0]; })
+            ]),
+            SGSection(@"Effects", @[
+                styleSlider(@"Blur", @"How strongly distant lyrics blur", 0.0, 12.0, 0.5,
+                            SGRKeyLyricsStyleBlur, 6.0,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.1f", value]; }),
+                styleSlider(@"Bloom / glare", @"Soft glow around the active lyric", 0.0, 100.0, 5.0,
+                            SGRKeyLyricsStyleBloom, 0.0,
+                            ^NSString *(double value) { return [NSString stringWithFormat:@"%.0f%%", value]; })
+            ]),
+            SGSection(@"Preset", @[
+                SGRLyricsStyleRow()
+            ]),
+            SGSection(@"Lyrics", @[
+                SGRLyricsTextSizesRow(),
+                SGLyricsWordTimingRow()
+            ])
+        ] footer:@"The controls above are live. You can leave this page open while a song is playing and watch the lyrics change."] ;
+        return page;
+    });
+}
+

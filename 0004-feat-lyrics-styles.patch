+    _line.textAlignment = _next.textAlignment = NSTextAlignmentCenter;
+    _line.numberOfLines = _next.numberOfLines = 1;
+    _line.textColor = _next.textColor = UIColor.whiteColor;
+    [self addSubview:_line];
+    [self addSubview:_next];

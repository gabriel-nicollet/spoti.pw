+static NSDictionary<NSNumber *, NSDictionary<NSString *, NSNumber *> *> *styleDefaults(void) {
+    return @{
+        @(SGRLyricsStyleDefault): @{ @"size": @30.0, @"weight": @0.70, @"gap": @24.0, @"dim": @0.30 },
+        @(SGRLyricsStyleSubtle): @{ @"size": @26.0, @"weight": @0.55, @"gap": @20.0, @"dim": @0.22 },
+        @(SGRLyricsStyleBold): @{ @"size": @34.0, @"weight": @0.90, @"gap": @28.0, @"dim": @0.35 },
+    };
+}
+
+static NSDictionary<NSString *, NSNumber *> *defaultsForStyle(SGRLyricsStyle style) {
+    return styleDefaults()[@(style)] ?: styleDefaults()[@(SGRLyricsStyleDefault)];
+}
+
+static void postLyricsStyleChange(void) {
+    [NSNotificationCenter.defaultCenter postNotificationName:SGRLyricsTextDidChangeNotification object:nil];
+}
+
+SGRLyricsStyle SGRLyricsStyleCurrent(void) {
+    NSInteger value = [NSUserDefaults.standardUserDefaults integerForKey:SGRKeyLyricsStyle];
+    return (SGRLyricsStyle)MAX(SGRLyricsStyleDefault, MIN(SGRLyricsStyleBold, value));
+}
+
+NSArray<NSString *> *SGRLyricsStyleNames(void) {
+    return @[@"Default", @"Subtle", @"Bold"];
+}
+
+static CGFloat styleNumber(NSString *key, NSString *field) {
+    SGRLyricsStyle style = SGRLyricsStyleCurrent();
+    if (![NSUserDefaults.standardUserDefaults objectForKey:key]) return defaultsForStyle(style)[field].doubleValue;
+    return [NSUserDefaults.standardUserDefaults doubleForKey:key];
+}
+
+CGFloat SGRLyricsStyleFontSize(void) { return styleNumber(SGRKeyLyricsStyleSize, @"size"); }
+CGFloat SGRLyricsStyleFontWeight(void) { return styleNumber(SGRKeyLyricsStyleWeight, @"weight"); }
+CGFloat SGRLyricsStyleLineGap(void) { return styleNumber(SGRKeyLyricsStyleGap, @"gap"); }
+CGFloat SGRLyricsDimAlpha(void) { return styleNumber(SGRKeyLyricsStyleDim, @"dim"); }
+
+void SGRSetLyricsStyle(SGRLyricsStyle style) {
+    style = (SGRLyricsStyle)MAX(SGRLyricsStyleDefault, MIN(SGRLyricsStyleBold, style));
+    NSDictionary *defaults = defaultsForStyle(style);
+    [NSUserDefaults.standardUserDefaults setInteger:style forKey:SGRKeyLyricsStyle];
+    [NSUserDefaults.standardUserDefaults setDouble:defaults[@"size"].doubleValue forKey:SGRKeyLyricsStyleSize];
+    [NSUserDefaults.standardUserDefaults setDouble:defaults[@"weight"].doubleValue forKey:SGRKeyLyricsStyleWeight];
+    [NSUserDefaults.standardUserDefaults setDouble:defaults[@"gap"].doubleValue forKey:SGRKeyLyricsStyleGap];
+    [NSUserDefaults.standardUserDefaults setDouble:defaults[@"dim"].doubleValue forKey:SGRKeyLyricsStyleDim];
+    postLyricsStyleChange();
+}
+
+void SGRSetLyricsStyleSize(CGFloat value) {
+    [NSUserDefaults.standardUserDefaults setDouble:MAX(22, MIN(42, value)) forKey:SGRKeyLyricsStyleSize];
+    postLyricsStyleChange();
+}
+
+void SGRSetLyricsStyleWeight(CGFloat value) {
+    [NSUserDefaults.standardUserDefaults setDouble:MAX(0.3, MIN(1.0, value)) forKey:SGRKeyLyricsStyleWeight];
+    postLyricsStyleChange();
+}
+
+void SGRSetLyricsStyleGap(CGFloat value) {
+    [NSUserDefaults.standardUserDefaults setDouble:MAX(12, MIN(40, value)) forKey:SGRKeyLyricsStyleGap];
+    postLyricsStyleChange();
+}
+
+void SGRSetLyricsStyleDim(CGFloat value) {
+    [NSUserDefaults.standardUserDefaults setDouble:MAX(0.12, MIN(0.50, value)) forKey:SGRKeyLyricsStyleDim];
+    postLyricsStyleChange();
+}

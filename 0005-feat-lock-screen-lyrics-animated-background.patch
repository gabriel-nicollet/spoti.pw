+// iOS 19 introduced MPMediaItemAnimatedArtwork: the system owns playback of a local artwork video.
+// We generate a small, cached loop from the same lyric card instead of trying to animate
+// MPMediaItemArtwork (which is inherently static).
+static NSCache<NSString *, NSURL *> *sg_animatedVideoCache;
+static NSObject *sg_animatedVideoLock;
+
+static UIImage *animatedFrame(UIImage *still, CGSize size, CGFloat phase) {
+    if (!still) return nil;
+    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat preferredFormat];
+    format.scale = 1;
+    format.opaque = YES;
+    return [[[UIGraphicsImageRenderer alloc] initWithSize:size format:format] imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        CGFloat pulse = 1.0 + 0.035 * sin(phase * M_PI * 2.0);
+        CGFloat x = 0.018 * size.width * sin(phase * M_PI * 2.0);
+        CGFloat y = 0.014 * size.height * cos(phase * M_PI * 2.0);
+        CGFloat w = size.width * pulse;
+        CGFloat h = size.height * pulse;
+        CGRect draw = CGRectMake((size.width - w) / 2.0 + x, (size.height - h) / 2.0 + y, w, h);
+        [still drawInRect:draw];
+    }];
+}
+
+static NSURL *writeAnimatedVideo(UIImage *still, CGSize requestedSize, NSString *cacheKey) {
+    if (!still) return nil;
+    CGSize size = requestedSize;
+    if (size.width < 32 || size.height < 32) size = CGSizeMake(512, 512);
+    CGFloat scale = MIN(1.0, 512.0 / MAX(size.width, size.height));
+    size = CGSizeMake(MAX(32, floor(size.width * scale)), MAX(32, floor(size.height * scale)));
+    size.width = floor(size.width / 2.0) * 2.0;
+    size.height = floor(size.height / 2.0) * 2.0;
+
+    NSString *safe = [NSString stringWithFormat:@"SpotifyGlass-Lyrics-%lu-%ldx%ld.mp4",
+                      (unsigned long)cacheKey.hash, (long)size.width, (long)size.height];
+    NSURL *url = [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:safe]];
+    if ([[NSFileManager defaultManager] fileExistsAtPath:url.path]) return url;
+
+    [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
+    NSError *error = nil;
+    AVAssetWriter *writer = [[AVAssetWriter alloc] initWithURL:url fileType:AVFileTypeMPEG4 error:&error];
+    if (!writer) return nil;
+
+    NSDictionary *settings = @{
+        AVVideoCodecKey: AVVideoCodecTypeH264,
+        AVVideoWidthKey: @(size.width),
+        AVVideoHeightKey: @(size.height),
+        AVVideoCompressionPropertiesKey: @{
+            AVVideoAverageBitRateKey: @(900000),
+            AVVideoExpectedSourceFrameRateKey: @15,
+            AVVideoMaxKeyFrameIntervalKey: @30
+        }
+    };
+    AVAssetWriterInput *input = [AVAssetWriterInput assetWriterInputWithMediaType:AVMediaTypeVideo outputSettings:settings];
+    input.expectsMediaDataInRealTime = NO;
+    NSDictionary *attributes = @{
+        (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferWidthKey: @(size.width),
+        (id)kCVPixelBufferHeightKey: @(size.height),
+        (id)kCVPixelBufferCGImageCompatibilityKey: @YES,
+        (id)kCVPixelBufferCGBitmapContextCompatibilityKey: @YES
+    };
+    AVAssetWriterInputPixelBufferAdaptor *adaptor =
+        [[AVAssetWriterInputPixelBufferAdaptor alloc] initWithAssetWriterInput:input sourcePixelBufferAttributes:attributes];
+    [writer addInput:input];
+    if (![writer startWriting]) return nil;
+    [writer startSessionAtSourceTime:kCMTimeZero];
+
+    CIContext *ci = [CIContext contextWithOptions:nil];
+    const NSInteger fps = 15;
+    const NSInteger frames = 60; // four seconds, looped by the system.
+    BOOL ok = YES;
+    for (NSInteger i = 0; i < frames; i++) {
+        while (!input.readyForMoreMediaData) [NSThread sleepForTimeInterval:0.002];
+        UIImage *frame = animatedFrame(still, size, (CGFloat)i / (CGFloat)frames);
+        CVPixelBufferRef buffer = NULL;
+        CVReturn created = CVPixelBufferCreate(kCFAllocatorDefault, (size_t)size.width, (size_t)size.height,
+                                               kCVPixelFormatType_32BGRA, (__bridge CFDictionaryRef)attributes, &buffer);
+        if (created != kCVReturnSuccess || !buffer) { ok = NO; break; }
+        CIImage *image = [[CIImage alloc] initWithImage:frame];
+        CVPixelBufferLockBaseAddress(buffer, 0);
+        [ci render:image toCVPixelBuffer:buffer bounds:CGRectMake(0, 0, size.width, size.height)
+          colorSpace:CGColorSpaceCreateDeviceRGB()];
+        CVPixelBufferUnlockBaseAddress(buffer, 0);
+        CMTime time = CMTimeMake(i, fps);
+        if (![adaptor appendPixelBuffer:buffer withPresentationTime:time]) ok = NO;
+        CVPixelBufferRelease(buffer);
+        if (!ok) break;
+    }
+    [input markAsFinished];
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    [writer finishWritingWithCompletionHandler:^{ dispatch_semaphore_signal(done); }];
+    dispatch_semaphore_wait(done, DISPATCH_TIME_FOREVER);
+    if (!ok || writer.status != AVAssetWriterStatusCompleted) {
+        [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
+        return nil;
+    }
+    return url;
+}
+
+API_AVAILABLE(ios(19.0))
+MPMediaItemAnimatedArtwork *SGLyricsAnimatedCoverArtwork(UIImage *cover, NSString *previous, NSString *current,
+                                                        NSString *next, NSString *artworkID, CGSize size) {
+    if (!cover || !artworkID.length) return nil;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        sg_animatedVideoCache = [NSCache new];
+        sg_animatedVideoLock = [NSObject new];
+    });
+
+    UIImage *preview = SGLyricsCoverImage(cover, previous, current, next, size);
+    NSString *key = [NSString stringWithFormat:@"%@|%ldx%ld", artworkID, (long)size.width, (long)size.height];
+
+    return [[MPMediaItemAnimatedArtwork alloc] initWithArtworkID:artworkID
+        previewImageRequestHandler:^(CGSize requested, void (^completion)(UIImage *image)) {
+            completion(preview ?: SGLyricsCoverImage(cover, previous, current, next, requested));
+        }
+        videoAssetFileURLRequestHandler:^(CGSize requested, void (^completion)(NSURL *url)) {
+            dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                NSURL *cached;
+                @synchronized (sg_animatedVideoLock) {
+                    cached = [sg_animatedVideoCache objectForKey:key];
+                }
+                if (!cached || ![[NSFileManager defaultManager] fileExistsAtPath:cached.path]) {
+                    cached = writeAnimatedVideo(preview, requested, key);
+                    if (cached) {
+                        @synchronized (sg_animatedVideoLock) {
+                            [sg_animatedVideoCache setObject:cached forKey:key];
+                        }
+                    }
+                }
+                completion(cached);
+            });
+        }];
+}

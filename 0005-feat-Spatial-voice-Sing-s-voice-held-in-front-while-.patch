diff --git a/harness/sing/spatial_test.c b/harness/sing/spatial_test.c
new file mode 100644
index 0000000..468aa15
--- /dev/null
+++ b/harness/sing/spatial_test.c
@@ -0,0 +1,157 @@
+// Tests SGSingSpatial.m and its place in the mixer: the voice's placement and its ear-to-ear time and level, the back-in-
+// front rule, the loss of the head, the instrumental's width, the room, and that the plain mix is untouched while off.
+// Plain C. From the repo root: see harness/sing/README.md (clang -x c -std=gnu11 ... -lm).
+#include "Shared/Sing/SGSingDSP.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define RATE 44100.0
+static int failures;
+#define CHECK(c, ...) do { if (!(c)) { failures++; printf("FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static SGSingSpatial *make(float distance, float room, float width, float recenter) {
+    SGSingSpatial *s = SGSingSpatialCreate(RATE);
+    SGSingSpatialParams p = {true, distance, room, width, recenter};
+    SGSingSpatialSetParams(s, &p);
+    SGSingSpatialSetActive(s, true);
+    return s;
+}
+// Runs `seconds` of a 220 Hz voice with the head at `yaw` (a new reading each 40 ms); returns RMS of each ear over the last 0.2 s.
+static void run(SGSingSpatial *s, double seconds, float yaw, double *left, double *right, unsigned *serial) {
+    uint64_t frames = (uint64_t)(seconds * RATE), tail = (uint64_t)(0.2 * RATE);
+    double l = 0, r = 0;
+    for (uint64_t i = 0; i < frames; i++) {
+        if (i % 1764 == 0) SGSingSpatialSetHead(s, yaw, ++*serial);
+        float in[2] = {0, 0}, out[2], voice = 0.5f * sinf((float)(2 * M_PI * 220 * i / RATE));
+        SGSingSpatialFrame(s, in, voice, out);
+        CHECK(isfinite(out[0]) && isfinite(out[1]) && fabsf(out[0]) < 4 && fabsf(out[1]) < 4, "unbounded output");
+        if (i >= frames - tail) { l += out[0] * out[0]; r += out[1] * out[1]; }
+    }
+    *left = sqrt(l / tail); *right = sqrt(r / tail);
+}
+
+int main(void) {
+    unsigned serial = 0;
+    double l, r;
+
+    // In front, the head still: both ears the same.
+    SGSingSpatial *s = make(1.5f, 0, 1, 0);
+    run(s, 1, 0.3f, &l, &r, &serial);
+    CHECK(fabs(l - r) < 1e-3 && l > 0.05, "front: left %.4f right %.4f", l, r);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) < 1e-3, "front azimuth %.3f", SGSingSpatialAzimuth(s));
+
+    // The head turns 90 degrees left: the voice that was ahead is on the right, so the right ear is louder.
+    run(s, 1, 0.3f + (float)M_PI / 2, &l, &r, &serial);
+    CHECK(r > l * 1.4, "head turned left: left %.4f right %.4f", l, r);
+    // And turned right, the left ear.
+    run(s, 1, 0.3f - (float)M_PI / 2, &l, &r, &serial);
+    CHECK(l > r * 1.4, "head turned right: left %.4f right %.4f", l, r);
+    SGSingSpatialDestroy(s);
+
+    // The time between the ears at 90 degrees: an impulse reaches the far ear about 29 samples after the near.
+    s = make(1.5f, 0, 1, 0);
+    for (unsigned i = 0; i < 4410; i++) { float in[2] = {0}, out[2]; if (i % 1764 == 0) SGSingSpatialSetHead(s, 0, ++serial); SGSingSpatialFrame(s, in, 0, out); }
+    for (unsigned i = 0; i < 4410; i++) { float in[2] = {0}, out[2]; if (i % 1764 == 0) SGSingSpatialSetHead(s, (float)M_PI / 2, ++serial); SGSingSpatialFrame(s, in, 0, out); }
+    int firstL = -1, firstR = -1;
+    for (unsigned i = 0; i < 400; i++) {
+        float in[2] = {0}, out[2];
+        SGSingSpatialFrame(s, in, i == 10 ? 1.0f : 0.0f, out);
+        if (firstL < 0 && fabsf(out[0]) > 0.02f) firstL = (int)i;
+        if (firstR < 0 && fabsf(out[1]) > 0.02f) firstR = (int)i;
+    }
+    CHECK(firstL - firstR >= 20 && firstL - firstR <= 36, "ear delay %d samples (right at %d, left at %d)", firstL - firstR, firstR, firstL);
+    SGSingSpatialDestroy(s);
+
+    // Back in front: turned 60 degrees and held, the voice comes round after 3 s; with Never it stays.
+    s = make(1.5f, 0, 1, 3);
+    run(s, 1, 0, &l, &r, &serial);
+    run(s, 1.5, 1.05f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) > 0.9f, "before the time the voice stays: azimuth %.2f", SGSingSpatialAzimuth(s));
+    run(s, 6, 1.05f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) < 0.03f && fabs(l - r) < 0.02, "after the time the voice is in front: azimuth %.3f left %.3f right %.3f", SGSingSpatialAzimuth(s), l, r);
+    SGSingSpatialDestroy(s);
+    s = make(1.5f, 0, 1, 0);
+    run(s, 1, 0, &l, &r, &serial);
+    run(s, 20, 1.05f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) > 0.9f, "never: azimuth %.2f", SGSingSpatialAzimuth(s));
+    SGSingSpatialRecenter(s);
+    run(s, 1, 1.05f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) < 0.03f, "recenter now: azimuth %.3f", SGSingSpatialAzimuth(s));
+    // A small turn, under 15 degrees, never counts as away.
+    SGSingSpatialDestroy(s);
+    s = make(1.5f, 0, 1, 2);
+    run(s, 1, 0, &l, &r, &serial);
+    run(s, 8, 0.15f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s) - 0.15f) < 0.02f, "a small turn is kept: azimuth %.3f", SGSingSpatialAzimuth(s));
+    SGSingSpatialDestroy(s);
+
+    // No head readings for over two seconds: the voice goes to the front.
+    s = make(1.5f, 0, 1, 0);
+    run(s, 1, 0, &l, &r, &serial);
+    run(s, 1, 1.2f, &l, &r, &serial);
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) > 1.0f, "turned: %.2f", SGSingSpatialAzimuth(s));
+    for (unsigned i = 0; i < (unsigned)(4 * RATE); i++) { float in[2] = {0}, out[2]; SGSingSpatialFrame(s, in, 0.1f, out); }
+    CHECK(fabsf(SGSingSpatialAzimuth(s)) < 1e-3f, "no head: azimuth %.3f", SGSingSpatialAzimuth(s));
+    SGSingSpatialDestroy(s);
+
+    // Distance: further is quieter.
+    double near, far;
+    s = make(0.8f, 0, 1, 0); run(s, 1, 0, &near, &r, &serial); SGSingSpatialDestroy(s);
+    s = make(4, 0, 1, 0); run(s, 1, 0, &far, &r, &serial); SGSingSpatialDestroy(s);
+    CHECK(near > far * 1.5, "distance: near %.3f far %.3f", near, far);
+
+    // Width: a left-only instrumental is mono at 0, as it was at 1, and wider at 2.
+    float inst[2] = {0.4f, 0}, out[2];
+    for (int w = 0; w <= 2; w++) {
+        s = make(1.5f, 0, (float)w, 0);
+        for (unsigned i = 0; i < 40000; i++) SGSingSpatialFrame(s, inst, 0, out);
+        if (w == 0) CHECK(fabsf(out[0] - out[1]) < 1e-4f && fabsf(out[0] - 0.2f) < 1e-3f, "width 0: %.4f %.4f", out[0], out[1]);
+        if (w == 1) CHECK(fabsf(out[0] - 0.4f) < 1e-3f && fabsf(out[1]) < 1e-3f, "width 1: %.4f %.4f", out[0], out[1]);
+        if (w == 2) CHECK(fabsf(out[0] - 0.6f) < 1e-3f && fabsf(out[1] + 0.2f) < 1e-3f, "width 2: %.4f %.4f", out[0], out[1]);
+        SGSingSpatialDestroy(s);
+    }
+
+    // Room: an impulse leaves a tail with the room up, and none with it down.
+    double tailDry = 0, tailWet = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        s = make(1.5f, pass ? 1.0f : 0.0f, 1, 0);
+        double energy = 0;
+        for (unsigned i = 0; i < 20000; i++) {
+            float in[2] = {0}, o[2];
+            if (i % 1764 == 0) SGSingSpatialSetHead(s, 0, ++serial);
+            SGSingSpatialFrame(s, in, i == 3000 ? 1.0f : 0.0f, o);
+            if (i > 3400) energy += o[0] * o[0] + o[1] * o[1];
+        }
+        (pass ? &tailWet : &tailDry)[0] = energy;
+        SGSingSpatialDestroy(s);
+    }
+    CHECK(tailDry < 1e-9 && tailWet > 1e-4, "room tail: dry %.2e wet %.2e", tailDry, tailWet);
+
+    // In the mixer: off (no amount) it is the plain Process, sample for sample.
+    enum { N = 2000 };
+    static float orig[N * 2], voc[N * 2], a[N * 2], b[N * 2];
+    srand(7);
+    for (unsigned i = 0; i < N * 2; i++) { orig[i] = (rand() / (float)RAND_MAX - 0.5f) * 0.6f; voc[i] = orig[i] * 0.4f; }
+    SGSingMixer m1, m2;
+    SGSingMixerInit(&m1, RATE, 0.5f); SGSingMixerInit(&m2, RATE, 0.5f);
+    s = SGSingSpatialCreate(RATE);
+    SGSingMixerProcess(&m1, orig, voc, a, N);
+    SGSingMixerProcessSpatial(&m2, s, orig, voc, b, N);
+    int same = 1;
+    for (unsigned i = 0; i < N * 2; i++) if (a[i] != b[i]) same = 0;
+    CHECK(same, "spatial off changed the plain mix");
+    // On, the instrumental alone (level 0) carries no voice: out is the widened instrumental (width 1: unchanged).
+    SGSingSpatialParams p = {true, 1.5f, 0.5f, 1, 0};
+    SGSingSpatialSetParams(s, &p); SGSingSpatialSetActive(s, true);
+    SGSingMixerInit(&m2, RATE, 0.0f);
+    for (int block = 0; block < 10; block++) SGSingMixerProcessSpatial(&m2, s, orig, voc, b, N);
+    double err = 0;
+    for (unsigned i = N; i < N * 2; i++) err += fabs(b[i] - (orig[i] - voc[i]));
+    CHECK(err / N < 1e-4, "karaoke with spatial on is not the instrumental: %.5f", err / N);
+    SGSingSpatialDestroy(s);
+
+    printf(failures ? "%d FAILED\n" : "spatial: placement, ear time and level, back in front, head loss, width, room and mixer passed\n", failures);
+    return failures ? 1 : 0;
+}

@@ -0,0 +1,161 @@
+// Mod Settings > Karaoke > Spatial voice: Sing's voice in one spot in front of you while the instruments play all around,
+// and with head-tracking AirPods the voice stays put as you turn. A picture from above shows what the sliders do (the voice's
+// dot sits where it is against your nose, live while a song plays), then the switch and four sounds: how far the voice is,
+// how much room it has, when it comes back in front, and how wide the instruments are. Everything applies at once.
+#import <UIKit/UIKit.h>
+#import "Core/SGCore.h"
+#import "Settings/SGModPage.h"
+#import "Settings/SGPageStyle.h"
+#import "Shared/HeadGestures/HeadGestures.h"
+#import "Shared/Sing/SGSingController.h"
+#import "Sing.h"
+
+static const NSInteger kDistanceDefault = 15, kRoomDefault = 30, kWidthDefault = 120, kBackDefault = 2; // tenths of a metre, %, %, index
+
+// The choices of "Back in front", in seconds; 0 is never.
+static NSArray<NSString *> *backNames(void) { return @[@"After 3 s", @"After 5 s", @"After 10 s", @"After 20 s", @"After 30 s", @"Never"]; }
+static const float kBackSeconds[] = {3, 5, 10, 20, 30, 0};
+
+SGSingSpatialParams SGRSingSpatialStored(void) {
+    NSInteger back = MAX(0, MIN(5, SGInt(SGRKeySingSpatialBack, kBackDefault)));
+    return (SGSingSpatialParams){
+        SGFlag(SGRKeySingSpatial, NO),
+        (float)MAX(5, MIN(60, SGInt(SGRKeySingSpatialDistance, kDistanceDefault))) / 10,
+        (float)MAX(0, MIN(100, SGInt(SGRKeySingSpatialRoom, kRoomDefault))) / 100,
+        (float)MAX(0, MIN(200, SGInt(SGRKeySingSpatialWidth, kWidthDefault))) / 100,
+        kBackSeconds[back],
+    };
+}
+
+#pragma mark - the picture
+
+// The scene from above: you at the middle with your nose up, the voice's dot where it is against your nose, a ring of
+// the instruments that opens out with the width, and rings of room around the voice that grow with it.
+@interface SGRSpatialPreview : UIView
+@end
+@implementation SGRSpatialPreview {
+    CADisplayLink *_link;
+    float _shown; // the voice's angle on screen, eased
+}
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
+    self.layer.cornerRadius = 22;
+    self.layer.cornerCurve = kCACornerCurveContinuous;
+    self.clipsToBounds = YES;
+    self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
+    self.isAccessibilityElement = YES;
+    self.accessibilityLabel = @"Spatial voice preview";
+    self.accessibilityValue = @"The voice in front of you, the instruments around you";
+    return self;
+}
+- (void)didMoveToWindow {
+    [super didMoveToWindow];
+    [_link invalidate]; _link = nil;
+    if (!self.window) return;
+    _link = [CADisplayLink displayLinkWithTarget:self selector:@selector(tick)];
+    _link.preferredFrameRateRange = CAFrameRateRangeMake(20, 30, 30);
+    [_link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+}
+- (void)tick {
+    float target = SGFlag(SGRKeySingSpatial, NO) ? SGSingVoiceAzimuth() : 0;
+    _shown += (target - _shown) * 0.35f;
+    [self setNeedsDisplay];
+}
+- (void)dealloc { [_link invalidate]; }
+- (void)drawRect:(CGRect)rect {
+    CGContextRef c = UIGraphicsGetCurrentContext();
+    SGSingSpatialParams p = SGRSingSpatialStored();
+    BOOL on = p.enabled;
+    CGPoint middle = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds) + 10);
+    CGFloat reach = MIN(self.bounds.size.width / 2, self.bounds.size.height) * 0.78;
+    UIColor *ink = [UIColor colorWithWhite:1 alpha:on ? 1 : 0.4];
+    // The instruments: dots on a ring, the more of it the wider they are.
+    CGFloat spread = M_PI * (0.25 + 0.75 * MIN(1, p.width / 2));
+    for (int side = -1; side <= 1; side += 2) {
+        for (int i = 0; i < 9; i++) {
+            CGFloat angle = (0.35 + (CGFloat)i / 8 * spread) * side; // measured from straight ahead
+            CGFloat rr = reach * 0.9;
+            CGPoint at = CGPointMake(middle.x + sin(angle) * rr, middle.y - cos(angle) * rr);
+            if (at.y > self.bounds.size.height - 4) at.y = self.bounds.size.height - 4;
+            CGContextSetFillColorWithColor(c, [ink colorWithAlphaComponent:0.22 + 0.04 * (8 - i)].CGColor);
+            CGContextFillEllipseInRect(c, CGRectMake(at.x - 4, at.y - 4, 8, 8));
+        }
+    }
+    CGContextSetFillColorWithColor(c, [ink colorWithAlphaComponent:0.2].CGColor);
+    // The voice: its dot, and the room round it as rings.
+    CGFloat angle = _shown, distance = reach * 0.25 + reach * 0.5 * (p.distance - 0.5f) / 5.5f;
+    CGPoint voice = CGPointMake(middle.x + sin(angle) * distance, middle.y - cos(angle) * distance);
+    for (int ring = 1; ring <= 3; ring++) {
+        CGFloat radius = 14 + ring * (6 + 22 * p.room);
+        CGContextSetStrokeColorWithColor(c, [ink colorWithAlphaComponent:(0.5 * p.room + 0.06) / ring].CGColor);
+        CGContextSetLineWidth(c, 1.5);
+        CGContextStrokeEllipseInRect(c, CGRectMake(voice.x - radius, voice.y - radius, radius * 2, radius * 2));
+    }
+    CGContextSetFillColorWithColor(c, ink.CGColor);
+    CGContextFillEllipseInRect(c, CGRectMake(voice.x - 9, voice.y - 9, 18, 18));
+    // You: a head and its nose.
+    CGContextSetFillColorWithColor(c, [UIColor colorWithWhite:1 alpha:on ? 0.9 : 0.35].CGColor);
+    CGContextFillEllipseInRect(c, CGRectMake(middle.x - 11, middle.y - 11, 22, 22));
+    CGContextMoveToPoint(c, middle.x - 5, middle.y - 9);
+    CGContextAddLineToPoint(c, middle.x, middle.y - 19);
+    CGContextAddLineToPoint(c, middle.x + 5, middle.y - 9);
+    CGContextFillPath(c);
+}
+@end
+
+#pragma mark - the page
+
+static SGModRow *numberRow(NSString *title, NSString *subtitle, NSString *key, NSInteger fallback, double min, double max, double step,
+                           NSString *(^format)(double)) {
+    return SGSliderRow(title, subtitle, min, max, step,
+                       ^double { return (double)MAX(min, MIN(max, SGInt(key, fallback))); },
+                       ^(double value) { SGSetInt(key, (NSInteger)llround(value)); SGRSingApplySpatial(); },
+                       format);
+}
+
+UIViewController *SGRSingSpatialSettingsPage(void) {
+    SGModRow *on = SGOptionRow(@"Spatial voice", @"The voice in front, the instruments around", SGRKeySingSpatial);
+    on.changed = ^(BOOL enabled) { SGRSingApplySpatial(); };
+    on.info = @"Sing splits the song into voice and instruments: the instruments play all around you, the voice comes from one spot "
+              "in front of you. With AirPods that track your head the voice stays in place as you turn. It works while Sing is on.";
+    SGModRow *status = SGStatRow(@"Head tracking", ^NSString * { return SGFlag(SGRKeySingSpatial, NO) ? SGHeadTrackingStatus() : @"Off"; });
+    // Insurance for the one thing that could not be tried off the phone: which way AirPods count a turn.
+    SGModRow *flip = SGOptionRow(@"Reverse turning", @"If the voice follows your head instead of staying put", SGRKeySingSpatialFlip);
+    flip.changed = ^(BOOL reversed) { SGRSingApplySpatial(); };
+    SGModRow *preview = SGViewRow([SGRSpatialPreview new], 200);
+
+    SGModRow *distance = numberRow(@"Distance", @"How far in front the voice is", SGRKeySingSpatialDistance, kDistanceDefault, 5, 60, 1,
+                                   ^NSString *(double v) { return [NSString stringWithFormat:@"%.1f m", v / 10]; });
+    SGModRow *room = numberRow(@"Room", @"How much of a room the voice sits in", SGRKeySingSpatialRoom, kRoomDefault, 0, 100, 5,
+                               ^NSString *(double v) { return [NSString stringWithFormat:@"%ld %%", (long)v]; });
+    SGModRow *back = SGChoiceRow(@"Back in front", @"When you turn away and stay turned", SGRKeySingSpatialBack, backNames(), kBackDefault);
+    back.chosen = ^(NSInteger index) { SGRSingApplySpatial(); };
+    SGModRow *width = numberRow(@"Instruments width", @"How far round you the instruments spread", SGRKeySingSpatialWidth, kWidthDefault, 0, 200, 5,
+                                ^NSString *(double v) { return [NSString stringWithFormat:@"%ld %%", (long)v]; });
+    SGModRow *front = SGActionRow(@"Put the voice in front now", @"Where your nose points", ^{ SGSingRecenterVoice(); });
+    SGModRow *reset = SGActionRow(@"Reset sounds", nil, ^{
+        SGSetInt(SGRKeySingSpatialDistance, kDistanceDefault); SGSetInt(SGRKeySingSpatialRoom, kRoomDefault);
+        SGSetInt(SGRKeySingSpatialWidth, kWidthDefault); SGSetInt(SGRKeySingSpatialBack, kBackDefault);
+        SGRSingApplySpatial();
+        UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Sounds reset"
+            message:@"Reopen the page to see the sliders." preferredStyle:UIAlertControllerStyleAlert];
+        [alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:nil]];
+        [SGTopController() presentViewController:alert animated:YES completion:nil];
+    });
+    NSArray<SGModSection *> *sections = @[
+        SGSection(nil, @[preview]),
+        SGNotedSection(nil, @[on, status, flip],
+                       @"Needs Sing on, in the lyrics' microphone. Head tracking needs AirPods Pro, AirPods Max or AirPods 3rd generation and later, "
+                       "and motion access when asked; without them the voice stays in front. Turn off Spatialize Stereo in the Control Center's "
+                       "sound settings, or the system spatializes the song twice. The voice is placed by a small model of a head, not by "
+                       "your own ears' measurements, so it is a spot in front and not an exact one."),
+        SGNotedSection(@"Sound", @[distance, room, back, width],
+                       @"Distance and Room make the voice nearer and drier or further and roomier. Instruments width is how far round you "
+                       "the instruments reach: 100 % is as the song was mixed, 0 % plays them in the middle."),
+        SGSection(nil, @[front, reset]),
+    ];
+    return [[SGModPage alloc] initWithTitle:@"Spatial voice" intro:nil sections:sections footer:nil];
+}

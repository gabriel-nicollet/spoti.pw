+            vocal[c] = isfinite(vocals[at]) ? vocals[at] : 0;
             // With the instrumental whole this is the original formula exactly, so a bypass or a full level returns the
             // original sample for sample; only the fade of the instrumental takes the second form.
-            float value = m->instrumental == 1 ? source - (1 - m->gain) * vocal : m->instrumental * (source - vocal) + m->gain * vocal;
-            out[at] = limit(value, eased); // bounded peak limiter, no per-stem normalization
+            plain[c] = m->instrumental == 1 ? source[c] - (1 - m->gain) * vocal[c] : m->instrumental * (source[c] - vocal[c]) + m->gain * vocal[c];
+        }
+        float amount = sp ? SGSingSpatialAmount(sp) : 0;
+        // Stepped while on or fading, and not at all when off, so a song without it pays nothing.
+        if (sp && SGSingSpatialBusy(sp)) {
+            float inst[2] = {m->instrumental * (source[0] - vocal[0]), m->instrumental * (source[1] - vocal[1])};
+            float voice = m->gain * (vocal[0] + vocal[1]) * 0.5f, placed[2];
+            SGSingSpatialFrame(sp, inst, voice, placed);
+            amount = SGSingSpatialAmount(sp);
+            for (unsigned c = 0; c < 2; c++) plain[c] += (placed[c] - plain[c]) * amount;
         }
+        for (unsigned c = 0; c < 2; c++) out[(size_t)i * 2 + c] = limit(plain[c], eased || amount > 0);
     }
 }
+void SGSingMixerProcess(SGSingMixer *m, const float *original, const float *vocals, float *out, uint32_t frames) {
+    SGSingMixerProcessSpatial(m, NULL, original, vocals, out, frames);
+}
diff --git a/tweak/Sources/Shared/Sing/SGSingSpatial.h b/tweak/Sources/Shared/Sing/SGSingSpatial.h
new file mode 100644
index 0000000..8c92eee
--- /dev/null
+++ b/tweak/Sources/Shared/Sing/SGSingSpatial.h
@@ -0,0 +1,51 @@
+// Spatial voice: Sing's separated stems placed in space. The instrumental plays around the listener, widened; the voice
+// comes from one spot in front, and with head-tracked AirPods it stays there as the head turns. Plain C, one frame at a
+// time, so it is tested off the phone (harness/sing/spatial_test.c) and runs on the render thread without allocating.
+//
+// How the voice is placed (a small binaural model, not a measured HRTF, so the cues are the ones a head makes):
+//   - azimuth    where the voice is relative to the nose: the head's yaw less the yaw it was anchored at
+//   - time       the sound reaches the far ear later, up to about 0.65 ms (Woodworth's spherical head)
+//   - level      the far ear is quieter and duller (the head's shadow), and a voice behind is duller and softer
+//   - distance   quieter as it goes further, with more of the room's sound in it
+//   - room       a short, dark reverb of the voice alone, so it sits in a space and not inside the head
+//
+// "Back in front": turned away and held for a while, the voice comes round to where the nose now points. Never, and it
+// stays where it was.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    bool enabled;
+    float distance;        // metres, 0.5 to 6
+    float room;            // 0 to 1, how much of the room's sound the voice carries
+    float width;           // 0 to 2, the instrumental's side signal: 1 as it was, 0 mono, 2 twice as wide
+    float recenterSeconds; // seconds turned away before the voice comes back in front; 0 never
+} SGSingSpatialParams;
+
+#define SGSingSpatialDistanceMin 0.5f
+#define SGSingSpatialDistanceMax 6.0f
+#define SGSingSpatialDefaultParams {false, 1.5f, 0.3f, 1.2f, 10} // an initializer: SGSingSpatialParams p = SGSingSpatialDefaultParams;
+
+typedef struct SGSingSpatial SGSingSpatial;
+
+SGSingSpatial *SGSingSpatialCreate(double sampleRate); // allocates; not on the render thread
+void SGSingSpatialDestroy(SGSingSpatial *spatial);
+// Render thread, or before it runs. Out-of-range numbers are brought in.
+void SGSingSpatialSetParams(SGSingSpatial *spatial, const SGSingSpatialParams *params);
+// The head's yaw in radians (counter-clockwise from above, as Core Motion has it) and a number that changes with each
+// new reading. No change for two seconds means no head to follow: the voice goes to the front.
+void SGSingSpatialSetHead(SGSingSpatial *spatial, float yaw, uint32_t serial);
+// Anchors the voice where the nose points now.
+void SGSingSpatialRecenter(SGSingSpatial *spatial);
+// How much of the output is the spatial mix and how much the plain one: ramps to 1 when `active`, to 0 when not (the
+// 120 ms of a bypass, so a song leaving Sing returns to the original without a step).
+void SGSingSpatialSetActive(SGSingSpatial *spatial, bool active);
+float SGSingSpatialAmount(const SGSingSpatial *spatial);
+bool SGSingSpatialBusy(const SGSingSpatial *spatial); // on, or still fading: frames must be run
+void SGSingSpatialResetAmount(SGSingSpatial *spatial); // straight to 0
+// Where the voice is now, relative to the nose in radians (positive to the right), for the settings page's picture.
+float SGSingSpatialAzimuth(const SGSingSpatial *spatial);
+// One stereo frame: the instrumental (already scaled), the voice as one channel (already scaled). `out` is the
+// instrumental widened plus the voice placed.
+void SGSingSpatialFrame(SGSingSpatial *spatial, const float instrumental[2], float voice, float out[2]);
diff --git a/tweak/Sources/Shared/Sing/SGSingSpatial.m b/tweak/Sources/Shared/Sing/SGSingSpatial.m
new file mode 100644
index 0000000..468c171
--- /dev/null
+++ b/tweak/Sources/Shared/Sing/SGSingSpatial.m
@@ -0,0 +1,222 @@
+#include "SGSingSpatial.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { kControlFrames = 256, kEarDelayMax = 64 };
+static const double kHeadRadius = 0.0875, kSpeedOfSound = 343;
+static const double kSmoothSeconds = 0.05;          // the placement glides this long to a new head reading
+static const double kStaleSeconds = 2;              // no new head reading for this long: no head to follow
+static const double kAwayRadians = 15 * M_PI / 180; // turned this far from the voice counts as away
+static const double kHomeRadians = 1.5 * M_PI / 180;
+static const double kGlideSeconds = 0.6;            // the time constant of the voice coming round to the front
+static const double kRiseSeconds = 0.25, kFallSeconds = 0.12;
+
+typedef struct { float *buffer, state; uint32_t length, at; } Delay;
+
+struct SGSingSpatial {
+    double rate;
+    SGSingSpatialParams params;
+    // The head. Written by SetHead / Recenter, read by control(); all on the render thread.
+    float head, anchor, rel;
+    uint32_t serial;
+    bool haveSerial, valid, gliding, recenterNow;
+    uint64_t clock, lastChange, awayStart;
+    bool away;
+    float azimuth;
+    // Placement, targets set by control() and smoothed per frame.
+    float latT, latS, backT, backS, gainLT, gainLS, gainRT, gainRS, cutLT, cutLS, cutRT, cutRS;
+    float widthT, widthS, wetT, wetS, itdT, itdS;
+    float lowL, lowR; // the head shadow's one-pole states
+    float smooth;
+    // The voice's own delay line, read at one delay for each ear.
+    float voiceLine[kEarDelayMax * 2];
+    uint32_t voiceAt;
+    // Reverb: four combs and two all-passes a side.
+    Delay comb[2][4], pass[2][2];
+    float feedback, damping;
+    uint32_t tick;
+    float amount, amountTarget;
+};
+
+static const uint32_t kCombLengths[4] = {1116, 1188, 1277, 1356}, kPassLengths[2] = {556, 441}, kSpread = 23;
+
+static float clampf(float v, float lo, float hi) { return !isfinite(v) ? lo : fmaxf(lo, fminf(hi, v)); }
+static double wrap(double angle) {
+    while (angle > M_PI) angle -= 2 * M_PI;
+    while (angle < -M_PI) angle += 2 * M_PI;
+    return angle;
+}
+
+static bool delayInit(Delay *d, uint32_t length) {
+    d->buffer = calloc(length, sizeof(float));
+    d->length = length; d->at = 0; d->state = 0;
+    return d->buffer != NULL;
+}
+
+SGSingSpatial *SGSingSpatialCreate(double rate) {
+    SGSingSpatial *s = calloc(1, sizeof *s);
+    if (!s) return NULL;
+    s->rate = isfinite(rate) && rate >= 8000 && rate <= 192000 ? rate : 44100;
+    double scale = s->rate / 44100;
+    bool ok = true;
+    for (unsigned side = 0; side < 2; side++) {
+        for (unsigned i = 0; i < 4; i++) ok &= delayInit(&s->comb[side][i], (uint32_t)((kCombLengths[i] + side * kSpread) * scale) + 1);
+        for (unsigned i = 0; i < 2; i++) ok &= delayInit(&s->pass[side][i], (uint32_t)((kPassLengths[i] + side * kSpread) * scale) + 1);
+    }
+    if (!ok) { SGSingSpatialDestroy(s); return NULL; }
+    s->smooth = 1 - expf(-1 / (float)(kSmoothSeconds * s->rate));
+    SGSingSpatialParams defaults = SGSingSpatialDefaultParams;
+    s->params = defaults;
+    s->damping = 0.4f;
+    s->gainLT = s->gainLS = s->gainRT = s->gainRS = 1;
+    s->cutLT = s->cutLS = s->cutRT = s->cutRS = 0.0f;
+    s->widthT = s->widthS = s->params.width;
+    SGSingSpatialSetParams(s, &s->params);
+    s->tick = kControlFrames; // the first frame makes a control pass
+    return s;
+}
+void SGSingSpatialDestroy(SGSingSpatial *s) {
+    if (!s) return;
+    for (unsigned side = 0; side < 2; side++) {
+        for (unsigned i = 0; i < 4; i++) free(s->comb[side][i].buffer);
+        for (unsigned i = 0; i < 2; i++) free(s->pass[side][i].buffer);
+    }
+    free(s);
+}
+
+void SGSingSpatialSetParams(SGSingSpatial *s, const SGSingSpatialParams *p) {
+    s->params.enabled = p->enabled;
+    s->params.distance = clampf(p->distance, SGSingSpatialDistanceMin, SGSingSpatialDistanceMax);
+    s->params.room = clampf(p->room, 0, 1);
+    s->params.width = clampf(p->width, 0, 2);
+    s->params.recenterSeconds = isfinite(p->recenterSeconds) && p->recenterSeconds > 0 ? fminf(p->recenterSeconds, 600) : 0;
+    s->feedback = 0.70f + 0.18f * s->params.room;
+    s->tick = kControlFrames; // placed again at once
+}
+void SGSingSpatialSetHead(SGSingSpatial *s, float yaw, uint32_t serial) {
+    if (!isfinite(yaw)) return;
+    s->head = yaw;
+    if (!s->haveSerial || serial != s->serial) {
+        if (!s->valid) { s->anchor = yaw; s->gliding = false; s->away = false; } // the first reading, or the first after a gap
+        s->serial = serial; s->haveSerial = true; s->valid = true; s->lastChange = s->clock;
+    }
+}
+void SGSingSpatialRecenter(SGSingSpatial *s) { s->recenterNow = true; s->tick = kControlFrames; }
+void SGSingSpatialSetActive(SGSingSpatial *s, bool active) { s->amountTarget = active ? 1 : 0; }
+float SGSingSpatialAmount(const SGSingSpatial *s) { return s->amount; }
+bool SGSingSpatialBusy(const SGSingSpatial *s) { return s->amount > 0 || s->amountTarget > 0; }
+void SGSingSpatialResetAmount(SGSingSpatial *s) { s->amount = s->amountTarget = 0; }
+float SGSingSpatialAzimuth(const SGSingSpatial *s) { return s->azimuth; }
+
+// Where the head is against the anchor, the "back in front" rule, and the targets the placement glides to.
+static void control(SGSingSpatial *s, uint32_t frames) {
+    double dt = frames / s->rate;
+    if (s->valid && s->clock - s->lastChange > (uint64_t)(kStaleSeconds * s->rate)) { s->valid = false; s->gliding = s->away = false; }
+    double rel = 0;
+    if (s->valid) {
+        if (s->recenterNow) { s->anchor = s->head; s->gliding = s->away = false; }
+        rel = wrap((double)s->head - s->anchor);
+        float seconds = s->params.recenterSeconds;
+        if (seconds > 0 && !s->gliding) {
+            if (fabs(rel) > kAwayRadians) {
+                if (!s->away) { s->away = true; s->awayStart = s->clock; }
+                if (s->clock - s->awayStart >= (uint64_t)(seconds * s->rate)) s->gliding = true;
+            } else {
+                s->away = false;
+            }
+        }
+        if (s->gliding || seconds == 0) { if (seconds == 0) s->gliding = false; }
+        if (s->gliding) {
+            s->anchor = (float)wrap(s->anchor + rel * (1 - exp(-dt / kGlideSeconds)));
+            rel = wrap((double)s->head - s->anchor);
+            if (fabs(rel) < kHomeRadians) { s->anchor = s->head; rel = 0; s->gliding = s->away = false; }
+        }
+    }
+    s->recenterNow = false;
+    s->rel = (float)rel;
+    // A head turned left by rel puts a voice that was ahead to its right: positive azimuth, to the right.
+    double theta = rel;
+    s->azimuth = (float)theta;
+    double lat = sin(theta), back = fmax(0, -cos(theta));
+    s->latT = (float)lat; s->backT = (float)back;
+    // Time: Woodworth, folded so a voice behind is as late as the same voice in front of the same ear.
+    s->itdT = (float)((kHeadRadius / kSpeedOfSound) * (asin(lat) + lat) * s->rate);
+    // Level and shadow: the far ear is down to 55 % and dull; the near one up a little; behind, softer and duller.
+    double distance = s->params.distance;
+    double distanceGain = pow(1 / fmax(distance, SGSingSpatialDistanceMin), 0.5) / sqrt(1 / 1.0);
+    distanceGain = fmin(distanceGain, 1.2);
+    double rear = 1 - 0.35 * back;
+    double shadowL = fmax(0, lat), shadowR = fmax(0, -lat);
+    s->gainLT = (float)(distanceGain * rear * (1 - 0.45 * shadowL + 0.12 * shadowR));
+    s->gainRT = (float)(distanceGain * rear * (1 - 0.45 * shadowR + 0.12 * shadowL));
+    // The one-pole low-pass for each ear: 20 kHz open to 3 kHz in full shadow, a third less behind.
+    double nyquistSafe = fmin(20000, s->rate * 0.45);
+    double cutL = nyquistSafe * pow(3000.0 / 20000.0, shadowL) * (1 - 0.5 * back);
+    double cutR = nyquistSafe * pow(3000.0 / 20000.0, shadowR) * (1 - 0.5 * back);
+    s->cutLT = (float)(1 - exp(-2 * M_PI * cutL / s->rate));
+    s->cutRT = (float)(1 - exp(-2 * M_PI * cutR / s->rate));
+    s->widthT = s->params.width;
+    // Room: the further the voice, the more of it is the room.
+    s->wetT = (float)(s->params.room * 0.6 * sqrt(distance / 1.5));
+    s->wetT = fminf(s->wetT, 1.2f);
+}
+
+static float comb(Delay *d, float input, float feedback, float damping) {
+    float out = d->buffer[d->at];
+    d->state = out * (1 - damping) + d->state * damping;
+    d->buffer[d->at] = input + d->state * feedback;
+    if (++d->at >= d->length) d->at = 0;
+    return out;
+}
+static float allpass(Delay *d, float input) {
+    float stored = d->buffer[d->at], out = stored - input;
+    d->buffer[d->at] = input + stored * 0.5f;
+    if (++d->at >= d->length) d->at = 0;
+    return out;
+}
+// The voice's delay line read `delay` samples back, interpolated.
+static float tap(const SGSingSpatial *s, float delay) {
+    float position = (float)s->voiceAt - delay;
+    while (position < 0) position += kEarDelayMax * 2;
+    uint32_t a = (uint32_t)position, b = a + 1;
+    float fraction = position - (float)a;
+    a %= kEarDelayMax * 2; b %= kEarDelayMax * 2;
+    return s->voiceLine[a] * (1 - fraction) + s->voiceLine[b] * fraction;
+}
+
+void SGSingSpatialFrame(SGSingSpatial *s, const float instrumental[2], float voice, float out[2]) {
+    if (s->tick >= kControlFrames) { control(s, s->tick > kControlFrames ? kControlFrames : s->tick); s->tick = 0; }
+    s->tick++; s->clock++;
+    float k = s->smooth;
+    s->latS += (s->latT - s->latS) * k; s->backS += (s->backT - s->backS) * k;
+    s->itdS += (s->itdT - s->itdS) * k;
+    s->gainLS += (s->gainLT - s->gainLS) * k; s->gainRS += (s->gainRT - s->gainRS) * k;
+    s->cutLS += (s->cutLT - s->cutLS) * k; s->cutRS += (s->cutRT - s->cutRS) * k;
+    s->widthS += (s->widthT - s->widthS) * k; s->wetS += (s->wetT - s->wetS) * k;
+    if (s->amount != s->amountTarget) {
+        float step = (float)(1 / ((s->amountTarget > s->amount ? kRiseSeconds : kFallSeconds) * s->rate));
+        s->amount = s->amountTarget > s->amount ? fminf(s->amountTarget, s->amount + step) : fmaxf(s->amountTarget, s->amount - step);
+    }
+    if (!isfinite(voice)) voice = 0;
+    // The voice, one delayed copy for each ear: the far ear's is later, the near one's is not.
+    s->voiceLine[s->voiceAt] = voice;
+    float itd = fminf(fabsf(s->itdS), (float)(kEarDelayMax - 2));
+    float delayL = s->itdS > 0 ? itd : 0, delayR = s->itdS < 0 ? itd : 0;
+    float left = tap(s, delayL), right = tap(s, delayR);
+    s->voiceAt = (s->voiceAt + 1) % (kEarDelayMax * 2);
+    s->lowL += (left - s->lowL) * s->cutLS; s->lowR += (right - s->lowR) * s->cutRS;
+    float directL = s->lowL * s->gainLS, directR = s->lowR * s->gainRS;
+    // The room, fed by the voice alone.
+    float send = voice * s->wetS, wetL = 0, wetR = 0;
+    for (unsigned i = 0; i < 4; i++) {
+        wetL += comb(&s->comb[0][i], send, s->feedback, s->damping);
+        wetR += comb(&s->comb[1][i], send, s->feedback, s->damping);
+    }
+    for (unsigned i = 0; i < 2; i++) { wetL = allpass(&s->pass[0][i], wetL); wetR = allpass(&s->pass[1][i], wetR); }
+    wetL *= 0.25f; wetR *= 0.25f;
+    // The instrumental, its sides stretched or pulled in.
+    float mid = (instrumental[0] + instrumental[1]) * 0.5f, side = (instrumental[0] - instrumental[1]) * 0.5f * s->widthS;
+    out[0] = mid + side + directL + wetL;
+    out[1] = mid - side + directR + wetR;
+}

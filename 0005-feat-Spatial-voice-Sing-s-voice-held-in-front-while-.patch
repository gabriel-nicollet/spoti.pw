 // What the slider's zone above 100 % does, handed over the same way, at launch and as it is chosen.
 void SGRSingApplyTopMode(void);
 
+// The spatial voice (SingSpatialSettings.m): its switch and four sounds, stored as whole numbers (distance in tenths of a
+// metre, room and width in percent, back in front as an index into "After 3 s … Never"), handed to Shared/Sing at launch and
+// as any of them changes. Applies at once.
+#define SGRKeySingSpatial @"spotifyglass.redesign.sing.spatial"                  // off until switched on
+#define SGRKeySingSpatialDistance @"spotifyglass.redesign.sing.spatial.distance"
+#define SGRKeySingSpatialRoom @"spotifyglass.redesign.sing.spatial.room"
+#define SGRKeySingSpatialWidth @"spotifyglass.redesign.sing.spatial.width"
+#define SGRKeySingSpatialFlip @"spotifyglass.redesign.sing.spatial.flip"            // off until switched on
+#define SGRKeySingSpatialBack @"spotifyglass.redesign.sing.spatial.back"
+#import "Shared/Sing/SGSingSpatial.h"
+void SGRSingApplySpatial(void);
+SGSingSpatialParams SGRSingSpatialStored(void);
+UIViewController *SGRSingSpatialSettingsPage(void);
+NSString *SGRSingSpatialSummary(void);
+
 // SingSettings.m: Mod Settings > Karaoke, with the switch and the voice model's download, and what its row on
 // the main page says beside the chevron (Off, On, No model, the download's percentage).
 UIViewController *SGRKaraokeSettingsPage(void);
